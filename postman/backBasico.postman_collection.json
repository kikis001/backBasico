{
  "info": {
    "_postman_id": "6b06522a-f297-46ba-98dd-9cc2695c51c4",
    "name": "backBasico - CRUD de pizzas",
    "description": "Coleccion para comprobar el CRUD de pizzas persistido en MongoDB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "pizza_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Crear pizza",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('pizza_id', Date.now().toString());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('La respuesta contiene la pizza creada', function () {",
              "  const pizzas = pm.response.json();",
              "  const id = Number(pm.collectionVariables.get('pizza_id'));",
              "  pm.expect(pizzas.some((pizza) => pizza.id === id)).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{pizza_id}},\n  \"nombre\": \"Cuatro quesos\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/pizzas",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "pizzas"
          ]
        }
      }
    },
    {
      "name": "2. Obtener todas las pizzas",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('La respuesta es una lista', function () {",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/pizzas",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "pizzas"
          ]
        }
      }
    },
    {
      "name": "3. Obtener pizza por id",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Devuelve el id solicitado', function () {",
              "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('pizza_id')));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/pizzas/{{pizza_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "pizzas",
            "{{pizza_id}}"
          ]
        }
      }
    },
    {
      "name": "4. Actualizar pizza",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Actualiza el nombre', function () {",
              "  pm.expect(pm.response.json().data.nombre).to.eql('Cuatro quesos especial');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Cuatro quesos especial\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/pizzas/{{pizza_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "pizzas",
            "{{pizza_id}}"
          ]
        }
      }
    },
    {
      "name": "5. Eliminar pizza",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Devuelve la pizza eliminada', function () {",
              "  pm.expect(pm.response.json().data.id).to.eql(Number(pm.collectionVariables.get('pizza_id')));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/pizzas/{{pizza_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "pizzas",
            "{{pizza_id}}"
          ]
        }
      }
    },
    {
      "name": "6. Confirmar eliminacion",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 404', function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/pizzas/{{pizza_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "pizzas",
            "{{pizza_id}}"
          ]
        }
      }
    }
  ]
}
